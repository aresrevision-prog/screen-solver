{
  "manifest_version": 3,
  "name": "screen-solver",
  "version": "2.0",
  "description": "A little floating window in your tab that reads the page and shows answers or marks.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }],
  "action": {
    "default_title": "screen-solver (Alt+S)",
    "default_icon": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+S" } } }
}
